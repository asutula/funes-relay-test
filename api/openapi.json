{
  "openapi": "3.1.0",
  "info": {"title": "Relay pilot payments API", "version": "1.0.0"},
  "paths": {
    "/payments": {
      "get": {
        "operationId": "listPayments",
        "description": "Return payments ordered by id ascending. This initial contract uses one-based numeric pages. No authentication is required for this local pilot.",
        "parameters": [
          {"name": "page", "in": "query", "schema": {"type": "integer", "minimum": 1, "default": 1}},
          {"name": "page_size", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 2}}
        ],
        "responses": {
          "200": {
            "description": "A page of payments; next_page is null when traversal is complete.",
            "content": {"application/json": {"schema": {
              "type": "object", "required": ["data", "next_page"], "additionalProperties": false,
              "properties": {
                "data": {"type": "array", "items": {"$ref": "#/components/schemas/Payment"}},
                "next_page": {"type": ["integer", "null"], "minimum": 1}
              }
            }}}
          },
          "400": {"description": "Invalid page or page_size", "content": {"application/json": {"schema": {
            "type": "object", "required": ["error"], "properties": {"error": {"type": "string"}}
          }}}}
        }
      }
    }
  },
  "components": {"schemas": {"Payment": {
    "type": "object", "required": ["id", "amount_cents", "currency"], "additionalProperties": false,
    "properties": {"id": {"type": "string"}, "amount_cents": {"type": "integer", "minimum": 0}, "currency": {"type": "string"}}
  }}}
}
